# Copy to .env.local and fill in. Only VITE_-prefixed vars reach the client bundle,
# so never put secrets here - everything below ships to the browser.

# Base URL of the API the app talks to.
# http://localhost:3000 is where `npm run mock` (json-server) serves data/db.json
VITE_API_URL=http://localhost:3000

# local  -> use the in-browser fake backend (src/mocks/fake-backend.js)
# remote -> talk to VITE_API_URL over axios
VITE_MODE=local
